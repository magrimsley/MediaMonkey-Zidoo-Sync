<Window x:Class="MediaMonkeyZidooSync.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MediaMonkey Zidoo Sync" Height="820" Width="1180" MinHeight="700" MinWidth="980" Closing="Window_Closing">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Menu Grid.Row="0" Margin="-18,-18,-18,12">
   <MenuItem Header="_File">
    <MenuItem Header="_Run Synchronization" Click="MenuRun_Click"/>
    <MenuItem Header="_Configuration" Click="MenuConfiguration_Click"/>
    <MenuItem Header="Run _History / Logs" Click="MenuHistory_Click"/>
    <Separator/><MenuItem Header="E_xit" Click="Exit_Click"/>
   </MenuItem>
   <MenuItem Header="_Help">
    <MenuItem Header="_Help / User Guide" Click="HelpGuide_Click"/>
    <MenuItem Header="_Troubleshooting" Click="Troubleshooting_Click"/>
    <Separator/><MenuItem Header="_About" Click="About_Click"/>
   </MenuItem>
   <MenuItem Header="X" Foreground="#FFFF5252" FontWeight="Bold" ToolTip="Exit MediaMonkey Zidoo Sync" Click="Exit_Click"/>
  </Menu>
  <DockPanel Grid.Row="1" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Left">
    <TextBlock Text="MediaMonkey Zidoo Sync" FontSize="26" FontWeight="SemiBold"/>
    
   </StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </StackPanel>
  </DockPanel>

  <TabControl x:Name="MainTabs" Grid.Row="2"
   BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
   BorderThickness="1" Padding="1">
   <TabItem Header="Synchronization">
    <Grid Margin="14">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <WrapPanel>
      <Button x:Name="ValidateMediaMonkeyButton" Content="1. Validate MediaMonkey Playlists" Padding="14,8" Click="ValidateMediaMonkey_Click"/>
      <Button x:Name="VerifyNativeExporterButton" Content="2. Verify Native Exporter" IsEnabled="False" Padding="14,8" Margin="10,0,0,0" Click="VerifyNativeExporter_Click"/>
      <Button x:Name="ReviewSynchronizationButton" Content="3. Review Changes" IsEnabled="False" Padding="14,8" Margin="10,0,0,0" Click="ReviewSynchronization_Click"/>
      <Button x:Name="RunButton" Content="4. Run Synchronization" IsEnabled="False" Padding="14,8" Margin="10,0,0,0" Click="Run_Click"/>
      </WrapPanel>
      <TextBlock x:Name="WorkflowHint" Text="Step 1: Validate MediaMonkey playlists." Margin="0,8,0,4" TextWrapping="Wrap"/>
      <Expander Header="Optional read-only diagnostics" Margin="0,4,0,0">
       <StackPanel Orientation="Horizontal">
        <Button x:Name="RunNativeAssessmentButton" Content="Run Native Assessment (Read-only)" IsEnabled="False" Padding="14,6" Click="RunNativeAssessment_Click"/>
        <Button x:Name="InspectNativePlanButton" Content="Inspect Plan (Read-only)" Padding="14,6" Margin="10,0,0,0" IsEnabled="False" Click="InspectNativePlan_Click"/>
       </StackPanel>
      </Expander>
     </StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,8">
      <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <CheckBox x:Name="ShowBlue" Content="Blue" IsChecked="True" Margin="0,0,14,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
      <CheckBox x:Name="ShowYellow" Content="Yellow" IsChecked="True" Margin="0,0,14,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
      <CheckBox x:Name="ShowGreen" Content="Green" IsChecked="True" Margin="0,0,14,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
      <CheckBox x:Name="ShowRed" Content="Red" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged"/>
     </StackPanel>
     <DockPanel Grid.Row="2">
       <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
         <Button Content="Open Latest Log" Padding="12,5" Click="OpenLatestOutputLog_Click"/>
         <TextBlock x:Name="ElapsedText" Text="Elapsed: 00:00:00" VerticalAlignment="Center" Margin="18,0,0,0"/>
       </StackPanel>
       <RichTextBox x:Name="OutputRichText" FontFamily="Consolas" FontSize="14"
                    Padding="10,8" Background="#FF181818" BorderBrush="#FF666666" BorderThickness="1"
                    IsReadOnly="True" IsDocumentEnabled="False" IsUndoEnabled="False"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <RichTextBox.ContextMenu>
           <ContextMenu>
             <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
             <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
             <Separator/>
             <MenuItem Header="Copy All Visible Output" Click="CopyAllOutput_Click"/>
           </ContextMenu>
         </RichTextBox.ContextMenu>
         <FlowDocument PagePadding="0" TextAlignment="Left"/>
       </RichTextBox>
     </DockPanel>
    </Grid>
   </TabItem>

   <TabItem x:Name="ConfigurationTab" Header="Configuration">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="16">
      <Expander x:Name="ZidooSection" Header="Zidoo" IsExpanded="True" Margin="0,18,0,0">
       <Grid Margin="0,8,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <TextBlock Text="IP Address" Grid.Row="0" Margin="0,6"/><TextBox x:Name="ZidooIp" Grid.Column="1" Grid.Row="0" Margin="4"/>
       <TextBlock Text="MAC Address" Grid.Row="1" Margin="0,6"/><TextBox x:Name="ZidooMac" Grid.Column="1" Grid.Row="1" Margin="4"/>
       <TextBlock Text="Expected Model" Grid.Row="2" Margin="0,6"/><TextBox x:Name="ExpectedModel" Grid.Column="1" Grid.Row="2" Margin="4"/>
       <TextBlock Text="API Port" Grid.Row="3" Margin="0,6"/><TextBox x:Name="ApiPort" Grid.Column="1" Grid.Row="3" Margin="4"/>
       <TextBlock Text="WOL Broadcast Address" Grid.Row="4" Margin="0,6"/><TextBox x:Name="Broadcast" Grid.Column="1" Grid.Row="4" Margin="4"/>
       <TextBlock Text="WOL Port" Grid.Row="5" Margin="0,6"/><TextBox x:Name="WolPort" Grid.Column="1" Grid.Row="5" Margin="4"/>
       <TextBlock Text="Playlist Grid Columns" Grid.Row="6" Margin="0,6" Visibility="Collapsed"/><TextBox x:Name="GridColumns" Grid.Column="1" Grid.Row="6" Margin="4" Visibility="Collapsed"/>
       <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="4,10,4,4">
        <Button x:Name="DiscoverZidooButton" Content="Discover Zidoo" Padding="14,7" Click="DiscoverZidoo_Click"/>
        <TextBlock x:Name="DiscoveryStatus" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
       </StackPanel>
      </Grid>
      </Expander>

      <Expander x:Name="MediaMonkeySection" Header="MediaMonkey" IsExpanded="True" Margin="0,18,0,0">
       <Grid Margin="0,8,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Database" Grid.Row="0" Margin="0,6"/><TextBox x:Name="MmDb" Grid.Column="1" Grid.Row="0" Margin="4"/>
       <TextBlock Text="Playlist Parent" Grid.Row="1" Margin="0,6"/><TextBox x:Name="PlaylistParent" Grid.Column="1" Grid.Row="1" Margin="4"/>
      </Grid>
      </Expander>

      <Expander x:Name="PlaylistStorageSection" Header="Playlist Storage / Music" IsExpanded="True" Margin="0,18,0,0">
       <Grid Margin="0,8,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <TextBlock Text="Host" Grid.Row="0" Margin="0,6"/><TextBox x:Name="NasHost" Grid.Column="1" Grid.Row="0" Margin="4"/>
       <TextBlock Text="Share Name" Grid.Row="1" Margin="0,6"/><TextBox x:Name="NasShare" Grid.Column="1" Grid.Row="1" Margin="4"/>
       <TextBlock Text="Music Folder Name" Grid.Row="2" Margin="0,6"/><TextBox x:Name="MusicFolderName" Grid.Column="1" Grid.Row="2" Margin="4"/>
       <TextBlock Text="Playlist Folder Name" Grid.Row="3" Margin="0,6"/><TextBox x:Name="PlaylistFolderName" Grid.Column="1" Grid.Row="3" Margin="4"/>
       <TextBlock Text="Music Root UNC" Grid.Row="4" Margin="0,6"/><TextBox x:Name="NasMusic" Grid.Column="1" Grid.Row="4" Margin="4"/>
       <TextBlock Text="Playlist Folder UNC" Grid.Row="5" Margin="0,6"/><TextBox x:Name="PlaylistFolder" Grid.Column="1" Grid.Row="5" Margin="4"/>
      </Grid>
      </Expander>

      <Expander x:Name="AdvancedSection" Header="Advanced" Margin="0,18,0,0">
       <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Report / Log Root" Grid.Row="0" Margin="0,6"/><TextBox x:Name="ReportRoot" Grid.Column="1" Grid.Row="0" Margin="4"/>
        <TextBlock Text="Readiness Timeout (sec)" Grid.Row="1" Margin="0,6"/><TextBox x:Name="ReadinessTimeout" Grid.Column="1" Grid.Row="1" Margin="4"/>
        <TextBlock Text="Cold Boot Stabilization (sec)" Grid.Row="2" Margin="0,6"/><TextBox x:Name="ColdBootSeconds" Grid.Column="1" Grid.Row="2" Margin="4"/>
       </Grid>
      </Expander>


      <Expander x:Name="ArchiveSection" Header="Configuration Archive" IsExpanded="True" Margin="0,20,0,20">
       <StackPanel Margin="0,8,0,0">
        <DataGrid x:Name="ConfigHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="180" SelectionMode="Single">
         <DataGrid.Columns>
          <DataGridTextColumn Header="Date / Time" Binding="{Binding Timestamp}" Width="190"/>
          <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="220"/>
          <DataGridTextColumn Header="Archive" Binding="{Binding Folder}" Width="*"/>
         </DataGrid.Columns>
        </DataGrid>
        <Button Content="Restore Selected Archive" Padding="16,7" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RestoreArchive_Click"/>
       </StackPanel>
      </Expander>
      <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
       <Button Content="Save Configuration" Padding="16,7" Click="SaveConfig_Click"/>
       <Button Content="Restore Last Known Good" Padding="16,7" Margin="10,0,0,0" Click="RestoreConfig_Click"/>
       <Button Content="Refresh History" Padding="16,7" Margin="10,0,0,0" Click="RefreshHistory_Click"/>
      </StackPanel>
      <TextBlock x:Name="ConfigMessage" Margin="0,12,0,0" TextWrapping="Wrap"/>

     </StackPanel>
    </ScrollViewer>
   </TabItem>

   <TabItem Header="Run History / Logs">
    <Grid Margin="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Expander Header="Run History / Logs" IsExpanded="True" Grid.Row="0">
     <DockPanel Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
       <Button Content="Refresh Runs" Padding="14,7" Click="RefreshRunHistory_Click"/>
       <Button Content="Open Selected Log" Padding="14,7" Margin="10,0,0,0" Click="OpenRunLog_Click"/>
       <TextBlock x:Name="RunHistoryStatus" Margin="14,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <DataGrid x:Name="RunHistoryGrid" Height="390" AutoGenerateColumns="False" IsReadOnly="True"
                SelectionMode="Single" MouseDoubleClick="OpenRunLog_Click">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Started" Binding="{Binding Started, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="175"/>
        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="210"/>
        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="240"/>
        <DataGridTextColumn Header="Elapsed" Binding="{Binding Elapsed}" Width="100"/>
        <DataGridTextColumn Header="Log" Binding="{Binding LogPath}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
     </Expander>
     <Expander Header="Recovery Diagnostics (Read-only)" Grid.Row="1" IsExpanded="False" Margin="0,12,0,0">
      <DockPanel Margin="0,8,0,0">
       <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <Button Content="Refresh Recovery Reports" Padding="14,7" HorizontalAlignment="Left" Click="RefreshRecoveryReports_Click"/>
        <TextBlock x:Name="RecoveryReportSummary" Margin="0,10,0,0" TextWrapping="Wrap" Text="Reports: 0 | Require review: 0 | Pending: 0 | Other: 0"/>
        <TextBlock x:Name="RecoveryReportStatus" Margin="0,5,0,0" TextWrapping="Wrap" Opacity="0.8"
                   Text="Read-only mode. Recovery execution disabled. Refresh to check for saved reports."/>
       </StackPanel>
       <DataGrid x:Name="RecoveryReportGrid" Height="200" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="170"/>
         <DataGridTextColumn Header="Transaction" Binding="{Binding TransactionId}" Width="230"/>
         <DataGridTextColumn Header="Recovery Status" Binding="{Binding Status}" Width="210"/>
         <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="230"/>
         <DataGridTextColumn Header="Report File" Binding="{Binding ReportPath}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
      </DockPanel>
     </Expander>
    </Grid>
   </TabItem>
  </TabControl>

  <Grid Grid.Row="3" Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Grid.Column="0" Opacity=".65"
    Text="The complete production log is always written by the synchronization engine. Display filters affect only this window."/>
   <TextBlock Grid.Column="1" x:Name="ProductVersionText" Text="Product version unavailable" Opacity=".65" HorizontalAlignment="Right" Margin="18,0,0,0"/>
  </Grid>
 </Grid>
</Window>
