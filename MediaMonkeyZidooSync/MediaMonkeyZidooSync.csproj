<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ApplicationIcon>Resources\Branding\Application.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MMZidooSync</AssemblyName><Product>MM Zidoo Sync</Product><AssemblyTitle>MM Zidoo Sync</AssemblyTitle>
    <RootNamespace>MediaMonkeyZidooSync</RootNamespace>
    <VersionPrefix>1.1.0</VersionPrefix>
    <VersionSuffix>rc.1</VersionSuffix>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <RevisionNumber Condition="'$(RevisionNumber)' == ''">0</RevisionNumber>
    <AssemblyVersion>1.1.$(BuildNumber).$(RevisionNumber)</AssemblyVersion>
    <FileVersion>1.1.$(BuildNumber).$(RevisionNumber)</FileVersion>
    <Deterministic>false</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\MediaMonkey-Zidoo-Config-v1.0.0.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
<ItemGroup>
<Resource Include="Resources\Branding\Application.ico" />
<Resource Include="Resources\Branding\Splash.jpg" />
<Content Include="Resources\Branding\Application.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
</ItemGroup>
  <ItemGroup>
    <Content Include="..\ThirdPartyNotices\**\*" Link="ThirdPartyNotices\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\LICENSE;..\THIRD-PARTY-NOTICES.md;..\ARTWORK-PROVENANCE.md;..\artwork-inventory.json;..\DONATIONS.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
