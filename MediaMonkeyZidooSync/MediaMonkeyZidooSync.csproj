<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MediaMonkey Zidoo Sync</AssemblyName>
    <RootNamespace>MediaMonkeyZidooSync</RootNamespace>
    <VersionPrefix>1.1</VersionPrefix>
    <VersionSuffix>alpha.60.17</VersionSuffix>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <RevisionNumber Condition="'$(RevisionNumber)' == ''">0</RevisionNumber>
    <AssemblyVersion>1.1.$(BuildNumber).$(RevisionNumber)</AssemblyVersion>
    <FileVersion>1.1.$(BuildNumber).$(RevisionNumber)</FileVersion>
    <Deterministic>false</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\MediaMonkey-Zidoo-Config-v1.0.0.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>

