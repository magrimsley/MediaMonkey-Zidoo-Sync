<Window x:Class="MediaMonkeyZidooSync.HelpWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="Resources/Branding/Application.ico" Title="MM Zidoo Sync - Help" Height="650" Width="950"
 MinHeight="500" MinWidth="760" WindowStartupLocation="CenterScreen">
 <Grid Margin="12">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="235"/>
   <ColumnDefinition Width="12"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Grid.RowDefinitions>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <DockPanel Grid.Column="0" Grid.Row="0"><Image x:Name="HelpBrandImage" DockPanel.Dock="Top" Source="Resources/Branding/Splash.jpg" Height="128" Stretch="Uniform" Margin="0,0,0,10"/><GroupBox Header="Help Topics">
   <ListBox x:Name="Topics" SelectionChanged="Topics_SelectionChanged">
    <ListBoxItem Tag="GettingStarted">Getting Started</ListBoxItem>
    <ListBoxItem Tag="Synchronization">Synchronization</ListBoxItem>
    <ListBoxItem Tag="Configuration">Configuration</ListBoxItem>
    <ListBoxItem Tag="StatusColors">Status / Output Colors</ListBoxItem>
    <ListBoxItem Tag="Archive">Configuration Archive</ListBoxItem>
    <ListBoxItem Tag="LastKnownGood">Last Known Good</ListBoxItem>
    <ListBoxItem Tag="History">Run History / Logs</ListBoxItem>
    <ListBoxItem Tag="Troubleshooting">Troubleshooting</ListBoxItem>
   </ListBox>
  </GroupBox></DockPanel>

  <Border Grid.Column="2" Grid.Row="0"
          BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
          BorderThickness="1" Padding="18">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="TopicTitle" Grid.Row="0"
               FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/>

    <StackPanel x:Name="ColorLegend" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,16">
     <StackPanel Orientation="Horizontal" Margin="0,3"><Ellipse Width="14" Height="14" Fill="DodgerBlue" Margin="0,0,8,0"/><TextBlock FontWeight="SemiBold">Blue â€” Information</TextBlock></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,3"><Ellipse Width="14" Height="14" Fill="Goldenrod" Margin="0,0,8,0"/><TextBlock FontWeight="SemiBold">Yellow â€” Warning / Recovery</TextBlock></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,3"><Ellipse Width="14" Height="14" Fill="ForestGreen" Margin="0,0,8,0"/><TextBlock FontWeight="SemiBold">Green â€” Success / Commit</TextBlock></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,3"><Ellipse Width="14" Height="14" Fill="Red" Margin="0,0,8,0"/><TextBlock FontWeight="SemiBold">Red â€” Error</TextBlock></StackPanel>
    </StackPanel>

    <FlowDocumentScrollViewer x:Name="TopicBody" Grid.Row="2" FontSize="14"
      Background="Transparent" BorderThickness="0" Padding="0"
      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
      IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled" FontFamily="Segoe UI">
     <FlowDocument PagePadding="0,0,18,0" LineHeight="22"
                   PageWidth="NaN" ColumnWidth="100000"/>
    </FlowDocumentScrollViewer>

    <StackPanel x:Name="ZidooDocumentationLinks" Grid.Row="3"
                Margin="0,16,0,0" Visibility="Collapsed">
     <TextBlock FontSize="14" Margin="0,8,0,0">
      <Hyperlink NavigateUri="https://www.zidoo.tv/Support/guide/guide_target/xqwZ8QMj6ZVKKmVViAFMcQ%3D%3D.html"
                 RequestNavigate="ZidooDocumentation_RequestNavigate">How to get the Ethernet MAC Address of a ZIDOO Box</Hyperlink>
     </TextBlock>
    </StackPanel>
   </Grid>
  </Border>

  <Button Grid.Row="1" Grid.Column="2" Content="Close" Width="90" Margin="0,12,0,0"
          HorizontalAlignment="Right" Click="Close_Click"/>
 </Grid>
</Window>
