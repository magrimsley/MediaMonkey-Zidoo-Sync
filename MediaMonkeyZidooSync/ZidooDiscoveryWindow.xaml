<Window x:Class="MediaMonkeyZidooSync.ZidooDiscoveryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Select Zidoo" Height="390" Width="820" MinHeight="330" MinWidth="700"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="More than one Zidoo device was discovered. Select the device to use, then choose Use Selected Device."
             TextWrapping="Wrap" Margin="0,0,0,12"/>
  <DataGrid x:Name="DevicesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
            SelectionMode="Single" CanUserAddRows="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="120"/>
    <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="160"/>
    <DataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}" Width="130"/>
    <DataGridTextColumn Header="Wired MAC" Binding="{Binding MacAddress}" Width="160"/>
    <DataGridTextColumn Header="Firmware" Binding="{Binding Firmware}" Width="120"/>
    <DataGridCheckBoxColumn Header="Validated" Binding="{Binding IsValidatedModel}" Width="80"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
   <Button Content="Use Selected Device" Padding="14,7" Click="Use_Click"/>
   <Button Content="Cancel" Padding="14,7" Margin="10,0,0,0" Click="Cancel_Click"/>
  </StackPanel>
 </Grid>
</Window>
